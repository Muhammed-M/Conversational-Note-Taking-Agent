# ── Gemini API ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemma-4-31b-it
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# ── Qdrant Vector Database ────────────────────────────────────────────────────
QDRANT_URL=https://your-cluster.aws.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_cloud_api_key_here
QDRANT_COLLECTION=notes

# ── Agent Behavior ────────────────────────────────────────────────────────────
MEMORY_SIZE=10          # how many past messages are sent to the LLM as context
TOP_K_KEYWORD=3         # keyword search: max number of results to return
TOP_K_TAG=3             # tag search: max number of results to return
TOP_K_SEMANTIC=1        # semantic search: max number of results to return
TOP_K_CANDIDATES=3      # update/delete: max candidate notes shown to the user
